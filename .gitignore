# Built example binaries / objects
examples/refl
examples/serialize_poc
*.o
*.so
*.dylib
.DS_Store

# Repo-local build state (recreate from scratch via CLAUDE.md)
build/
.venv/

# Repo-local LLVM toolchain (built from the llvm-project submodule)
toolchain/
toolchain-build/
toolchain-build.log

# corpus campaign scratch (reconstructible from submodule pins + binding sources)
corpus/runs/*/binding/build/
corpus/runs/*/binding/build-emit/
corpus/runs/*/binding/*.o
corpus/runs/*/tests/build/
corpus/runs/*/logs/
corpus/runs/*/.pytest_cache/
**/__pycache__/

# compiled finding repros (corpus/findings/repros/*/repro.cpp builds)
corpus/findings/repros/*/repro
