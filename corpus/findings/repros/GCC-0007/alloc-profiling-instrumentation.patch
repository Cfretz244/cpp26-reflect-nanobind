+/* TEMPORARY GCC-0007 instrumentation: per-return-address allocation
+   histogram, dumped on demand from gdb via ggc_alloc_profile_dump().  */
+static struct { void *a0; void *a1; unsigned long count; unsigned long bytes; }
+  ggc_alloc_prof[16384];
+static void
+ggc_alloc_profile_record (void *a0, void *a1, size_t size)
+{
+  size_t h = ((((uintptr_t) a0) >> 2) * 31 + (((uintptr_t) a1) >> 2)) % 16381;
+  for (int i = 0; i < 256; i++)
+    {
+      size_t j = (h + i) % 16381;
+      if ((ggc_alloc_prof[j].a0 == a0 && ggc_alloc_prof[j].a1 == a1)
+	  || !ggc_alloc_prof[j].a0)
+	{
+	  ggc_alloc_prof[j].a0 = a0;
+	  ggc_alloc_prof[j].a1 = a1;
+	  ggc_alloc_prof[j].count++;
+	  ggc_alloc_prof[j].bytes += size;
+	  return;
+	}
+    }
+}
+extern "C" void ggc_alloc_profile_dump (void);
+extern "C" void
+ggc_alloc_profile_dump (void)
+{
+  for (size_t j = 0; j < 16381; j++)
+    if (ggc_alloc_prof[j].a0)
+      fprintf (stderr, "GGCPROF %p %p %lu %lu\n", ggc_alloc_prof[j].a0,
+	       ggc_alloc_prof[j].a1, ggc_alloc_prof[j].count,
+	       ggc_alloc_prof[j].bytes);
+}
