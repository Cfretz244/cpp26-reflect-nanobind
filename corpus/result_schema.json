{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "corpus per-run result",
  "type": "object",
  "required": ["schema_version", "slug", "outcome", "furthest_gate", "gate_results"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "slug": { "type": "string" },
    "url": { "type": "string" },
    "pinned_commit": { "type": "string" },
    "tier": { "type": "integer" },
    "header_only": { "type": "boolean" },
    "run_id": { "type": "string" },
    "toolchain_commit": { "type": "string" },
    "binder_commit": { "type": "string" },
    "prod_compiler": { "type": "string" },
    "outcome": { "enum": ["A", "B", "C", "D", "E", "E-weak"] },
    "furthest_gate": { "type": "integer", "minimum": 0, "maximum": 6 },
    "gate_results": {
      "type": "object",
      "properties": {
        "1_probe":   { "enum": ["pass", "fail", "skip"] },
        "3_strategy":{ "enum": ["single_stage", "two_stage"] },
        "4_compile": { "enum": ["pass", "fail", "skip"] },
        "5_import":  { "enum": ["pass", "fail", "skip"] },
        "6_correct": { "enum": ["pass", "fail", "skip"] }
      }
    },
    "lanes": {
      "description": "schema v2: per-backend gate ladders. `constexpr` is nb::reflect_ compiled by the P2996 toolchain; `emit` is the generated-source module compiled by the PRODUCTION compiler (Apple Clang + system libc++). The top-level outcome is the WORST lane (a Gate 6b surface mismatch forces D). The v1 top-level gate_results/furthest_gate/failure mirror the constexpr lane.",
      "type": "object",
      "properties": {
        "constexpr": { "$ref": "#/definitions/lane" },
        "emit":      { "$ref": "#/definitions/lane" }
      }
    },
    "surface_diff": {
      "description": "Gate 6b: module-vs-module API-surface differential (corpus/lib/surface_diff.py), run when both lanes import.",
      "type": "object",
      "properties": {
        "status": { "enum": ["pass", "fail", "skip"] },
        "mismatches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subset": {
      "type": "object",
      "properties": {
        "reflect_args": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "skipped_features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "oracle": {
      "type": "object",
      "properties": {
        "layers_used": { "type": "array", "items": { "type": "string" } },
        "assertions_total": { "type": "integer" },
        "assertions_passed": { "type": "integer" },
        "ground_truth_source": { "type": "string" }
      }
    },
    "failure": {
      "type": "object",
      "properties": {
        "code": { "type": ["string", "null"] },
        "first_diagnostics": { "type": "array", "items": { "type": "string" } },
        "signal": { "type": ["string", "null"] }
      }
    },
    "toolchain_bug": {
      "type": "object",
      "properties": {
        "status": { "enum": ["none", "suspected", "confirmed"] },
        "kind": { "type": "string" },
        "signature": { "type": "string" },
        "repro": { "type": "string" },
        "finding": { "type": "string" }
      }
    },
    "metrics": { "type": "object" },
    "artifacts": { "type": "object" },
    "notes": { "type": "string" }
  },
  "definitions": {
    "lane": {
      "type": "object",
      "required": ["outcome", "furthest_gate", "gate_results"],
      "properties": {
        "outcome": { "enum": ["A", "B", "C", "D", "E", "E-weak"] },
        "furthest_gate": { "type": "integer", "minimum": 0, "maximum": 6 },
        "gate_results": {
          "type": "object",
          "properties": {
            "4_compile": { "enum": ["pass", "fail", "skip"] },
            "5_import":  { "enum": ["pass", "fail", "skip"] },
            "6_correct": { "enum": ["pass", "fail", "skip"] }
          }
        },
        "failure": {
          "type": "object",
          "properties": {
            "code": {
              "description": "B.emit_gen_compile / B.emit_gen_run (stage 1, reflection toolchain), B.emit_compile / B.emit_extra_compile / B.emit_link (stage 2, production compiler), C.*, D.value -- plus the v1 codes on the constexpr lane.",
              "type": ["string", "null"]
            },
            "first_diagnostics": { "type": "array", "items": { "type": "string" } },
            "signal": { "type": ["string", "null"] }
          }
        },
        "metrics": { "type": "object" },
        "oracle": { "type": "object" }
      }
    }
  }
}
